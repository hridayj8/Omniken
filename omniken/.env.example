# Omniken — Environment Configuration
# Copy to .env and fill in your values

# Supabase (for user auth + license management)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Database (Postgres with Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/omniken

# Stripe (for payment processing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Omniken
OMNIKEN_ENV=development
OMNIKEN_LOG_LEVEL=info
OMNIKEN_MAX_TOKENS=128000
OMNIKEN_DEFAULT_COMPRESSION=47
