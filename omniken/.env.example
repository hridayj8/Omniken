# Omniken — Environment Configuration
# Copy to .env and fill in your values
# WARNING: Never commit .env to Git. This file is already in .gitignore.

# ── Supabase (from Dashboard -> Project Settings -> API) ──────
SUPABASE_URL=https://nhkscsynarfbwgfcrgva.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Database (from Dashboard -> Project Settings -> Database) ─
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ppbepczquphfpmxfelyk.supabase.co:5432/postgres

# ── Stripe (for payment processing) ───────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Omniken Engine ────────────────────────────────────────────
OMNIKEN_ENV=production
OMNIKEN_LOG_LEVEL=info
OMNIKEN_MAX_TOKENS=128000
OMNIKEN_DEFAULT_COMPRESSION=47
