# Omniken — Supabase & Database Configuration
# Copy this file to omniken/.env (not supabase/.env) — that's what app.py reads.
# See omniken/.env.example for the complete template with all fields.

# Supabase project credentials
SUPABASE_URL=https://nhkscsynarfbwgfcrgva.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Direct Postgres connection (use password from Supabase Dashboard -> Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ppbepczquphfpmxfelyk.supabase.co:5432/postgres

# Stripe (for payment processing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Omniken Engine
OMNIKEN_ENV=production
OMNIKEN_LOG_LEVEL=info
OMNIKEN_MAX_TOKENS=128000
OMNIKEN_DEFAULT_COMPRESSION=47
